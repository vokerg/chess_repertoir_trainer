# Example environment variables for the chess repertoire trainer API and Angular build
#
# Copy this file to:
#   apps/api/.env
# For the Angular app, expose the WEB_* values in your web build environment.
# Native Expo configuration has a separate template at apps/mobile/.env.example.

# Angular frontend API base URL. Use /api with the Angular dev proxy.
WEB_API_BASE_URL=/api
WEB_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

# API port
PORT=3000

# Request authentication. Use dev-single-user only for local web/API development.
# Mobile download/sync flows require Clerk bearer tokens and therefore AUTH_MODE=clerk.
AUTH_MODE=dev-single-user
DEV_SINGLE_USER_ID=1

# Clerk JWT verification settings used when AUTH_MODE=clerk.
CLERK_JWT_ISSUER="https://your-clerk-instance.clerk.accounts.dev"
CLERK_JWKS_URL="https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json"
# Comma-separated `azp` allow-list for browser clients, for example Angular local
# development and production. Native Expo session tokens may omit `azp`; they remain
# strictly validated by signature, issuer, optional audience, and subject.
CLERK_AUTHORIZED_PARTIES="http://localhost:4200,https://your-clerk-instance.clerk.accounts.dev"
# CLERK_JWT_AUDIENCE="your-api-audience"

# Server-only administrator diagnostics. Disabled by default. The allow-list contains
# exact opaque Clerk subjects, never email addresses. Enabling it requires AUTH_MODE=clerk.
ADMIN_AUTH_MODE=disabled
# ADMIN_AUTH_MODE=clerk-subject-allowlist
# ADMIN_CLERK_SUBJECT_ALLOWLIST="user_abc123,user_def456"
# ADMIN_ACTOR_KEY_SECRET="replace-with-at-least-32-random-utf8-bytes"
# ADMIN_ACTOR_KEY_VERSION=1

# The initial administrator diagnostics release has strict bounded queries and structured
# security telemetry, but no shared multi-replica request limiter. It does not emit 429
# unless a real enforcing AdminRequestBudget implementation is explicitly injected.

# Neon pooled connection string for the running app
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-POOLED-HOST/neondb?sslmode=require&channel_binding=require"

# Direct Neon connection string for Prisma CLI commands such as migrate/seed
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-DIRECT-HOST/neondb?sslmode=require&channel_binding=require"

# Prisma log level (optional, can be info/debug)
PRISMA_LOG_LEVEL=info

# CORS origin allowed for Angular during local development
CORS_ORIGIN=http://localhost:4200

# Optional on-demand AI widgets. The global flag and each use-case flag are disabled by
# default. LLM configuration stays on the API service and is never exposed to Angular.
AI_WIDGETS_ENABLED=false
AI_GAME_REVIEW_ENABLED=false
AI_BUILDER_CANDIDATE_EXPLANATION_ENABLED=false
AI_BUILDER_COMPLETION_SUMMARY_ENABLED=false
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=1
LLM_THINKING_MODE=disabled
# Used only when thinking mode is enabled. Supported values: high, max.
LLM_REASONING_EFFORT=
LLM_DEBUG_LOGGING=false

# Persistent imported-game worker tuning. Defaults are shown; override only when the
# deployment shutdown window or workload requires it. Stale-after must remain more
# than twice the heartbeat interval. Terminal jobs and their tasks are retained for
# the configured number of days before worker cleanup removes them.
JOB_WORKER_POLL_INTERVAL_MS=1000
JOB_WORKER_HEARTBEAT_INTERVAL_MS=30000
JOB_WORKER_STALE_AFTER_MS=900000
JOB_WORKER_STALE_RECOVERY_INTERVAL_MS=60000
JOB_WORKER_TERMINAL_RETENTION_DAYS=30
JOB_WORKER_SLICE_SIZE=25
JOB_WORKER_SHUTDOWN_TIMEOUT_MS=30000

# Durable account-import worker tuning. The account-import loop shares the worker process
# but has its own PostgreSQL claim/heartbeat lifecycle and does not use JobRun/JobTask.
# Stale-after must remain more than twice the heartbeat interval. Backlog warnings fire
# when queue age exceeds five minutes or more than 20 queued runs persist for five minutes.
ACCOUNT_IMPORT_WORKER_POLL_INTERVAL_MS=1000
ACCOUNT_IMPORT_WORKER_HEARTBEAT_INTERVAL_MS=15000
ACCOUNT_IMPORT_WORKER_STALE_AFTER_MS=120000
ACCOUNT_IMPORT_WORKER_STALE_RECOVERY_INTERVAL_MS=30000
ACCOUNT_IMPORT_WORKER_SHUTDOWN_TIMEOUT_MS=30000
ACCOUNT_IMPORT_WORKER_BACKLOG_RUN_THRESHOLD=20
ACCOUNT_IMPORT_WORKER_BACKLOG_AGE_MS=300000
ACCOUNT_IMPORT_WORKER_BACKLOG_SUSTAINED_MS=300000

# Account/game destructive lifecycle worker tuning. It runs in the same persistent worker
# process but claims DataLifecycleOperation rows independently. Stale-after must remain more
# than twice the heartbeat interval. Each destructive transaction processes at most the
# configured game batch limit and the hard contract ceiling is 100 games.
DATA_LIFECYCLE_WORKER_POLL_INTERVAL_MS=1000
DATA_LIFECYCLE_WORKER_HEARTBEAT_INTERVAL_MS=10000
DATA_LIFECYCLE_WORKER_STALE_AFTER_MS=60000
DATA_LIFECYCLE_WORKER_STALE_RECOVERY_INTERVAL_MS=30000
DATA_LIFECYCLE_WORKER_SHUTDOWN_TIMEOUT_MS=30000
DATA_LIFECYCLE_WORKER_GAME_BATCH_LIMIT=25

# Bounded Lichess durable-import provider tuning. Requests remain serial through the
# global account-import claim. Database batches may be smaller but never exceed 100.
LICHESS_IMPORT_WINDOW_DAYS=14
IMPORT_DATABASE_WRITE_BATCH_SIZE=100

# Lichess OAuth. The token encryption key must decode to exactly 32 bytes.
# Users must reconnect Lichess after changing OAuth scopes.
LICHESS_OAUTH_CLIENT_ID="chess-repertoire-trainer-local"
LICHESS_OAUTH_REDIRECT_URI="http://localhost:3000/api/auth/lichess/callback"
LICHESS_OAUTH_SCOPES="challenge:write puzzle:read puzzle:write"
LICHESS_BOT_CHALLENGE_USERNAMES="maia1,maia5,maia9"
LICHESS_DEFAULT_BOT_CHALLENGE_USERNAME="maia5"
LICHESS_TOKEN_ENCRYPTION_KEY="base64-32-byte-key-here"
WEB_APP_URL="http://localhost:4200"

# Enables Stockfish-backed imported-game analysis in the persistent worker's
# ANALYSE_GAMES / PROCESS_GAMES executors.
LOCAL_BATCH_STOCKFISH_ANALYSIS_ENABLED=false
# `local` uses STOCKFISH_PATH. `wasm` uses the npm stockfish package in a worker thread.
STOCKFISH_ENGINE=local
STOCKFISH_PATH=stockfish
STOCKFISH_ANALYSIS_DEPTH=12
STOCKFISH_ANALYSIS_TIMEOUT_MS=15000
